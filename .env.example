# --- Site ---
# Adresse publique exacte, sans slash final (sert aux URL de retour et au webhook CamerPay).
NEXT_PUBLIC_SITE_URL=https://www.complexelafleur.com

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement. Ne jamais l'exposer au navigateur ni la partager.
SUPABASE_SERVICE_ROLE_KEY=

# --- CamerPay (https://camerpay.biz/client/api) ---
CAMERPAY_BASE_URL=https://camerpay.biz
CAMERPAY_API_TOKEN=
# Secret de signature HMAC-SHA256 des webhooks
CAMERPAY_WEBHOOK_SECRET=
# En-tête qui porte la signature. S'il est faux, les webhooks sont rejetés (401) :
# les logs Vercel listent alors les noms des en-têtes reçus pour trouver le bon.
CAMERPAY_SIGNATURE_HEADER=x-camerpay-signature
# Tests locaux uniquement. Ignoré en production Vercel (VERCEL_ENV=production).
CAMERPAY_ALLOW_UNSIGNED=false

# --- E-mails (https://resend.com) ---
RESEND_API_KEY=
# Doit utiliser un domaine VÉRIFIÉ dans Resend (pas gmail.com).
MAIL_FROM="Complexe Lafleur <reservations@complexelafleur.com>"
